POSTGRES_DB=invest_tracker
POSTGRES_USER=invest_tracker
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://localhost:5432/invest_tracker
DATABASE_USERNAME=invest_tracker
DATABASE_PASSWORD=change-me

# Market Data & FX (Twelve Data)
TWELVEDATA_ENABLED=true
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com

# Market Data Option B (Financial Modeling Prep - FMP)
FMP_ENABLED=true
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com

# Market Data Option C / Tertiary (Yahoo Finance)
YAHOO_FINANCE_ENABLED=true
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# ─── AI Portfolio & Holding Intelligence Engine ────────────────────────────────
# Select provider: LM_STUDIO | OPENAI | GEMINI | ANTHROPIC
AI_PROVIDER=LM_STUDIO
AI_ENABLED=true
AI_TIMEOUT_SECONDS=1200

# Shared inference settings (interpretation depends on provider)
AI_MODEL=google/gemma-4-12b
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048

# ── LM Studio (local, default) ──────────────────────────────────────────────
AI_BASE_URL=http://host.docker.internal:1234
AI_API_KEY=

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Set AI_PROVIDER=OPENAI and AI_MODEL=gpt-4o-mini (or any supported model)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# ── Google Gemini ────────────────────────────────────────────────────────────
# Set AI_PROVIDER=GEMINI and AI_MODEL=gemini-2.0-flash (or any supported model)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ── Anthropic Claude ─────────────────────────────────────────────────────────
# Set AI_PROVIDER=ANTHROPIC and AI_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
